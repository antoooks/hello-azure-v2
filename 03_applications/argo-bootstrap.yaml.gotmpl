# bootstrapping argo. To be done only once.
environments:
  test:
    values:
      -
        self:
          namespace: unique
          # [ARGOCD-OIDC] Argo CD login mode:
          #   admin = built-in admin account, username/password (values/argo/argo-auth-admin.yaml)
          #   oidc  = Entra ID login (values/argo/argo-auth-oidc.yaml); also needs gitops_app_registration_enabled = true
          #           in 02_infrastructure day-2
          # Keep apps/system/argo.yaml in line (Argo CD manages itself from it); the check below fails if it differs.
          argoAuth: admin
---
{{- /*
  First-time bootstrap on an empty cluster: the argo release creates ExternalSecret objects
  (values/argo/argo-repository-secrets.yaml), but the External Secrets Operator that defines that kind is itself
  deployed later by Argo CD (apps/system/external-secrets.yaml). The presync hook on argo applies the ESO CRDs
  first, at the same chart version Argo CD deploys, read from that app file so the two cannot drift apart.
*/}}
{{- $esoVersion := "" }}
{{- range (readFile (printf "%s/apps/system/external-secrets.yaml" .Environment.Name) | fromYaml).spec.sources }}
{{- if eq (get "chart" "" .) "external-secrets" }}{{ $esoVersion = .targetRevision }}{{ end }}
{{- end }}
{{- if not $esoVersion }}{{ fail "argo-bootstrap: could not read the external-secrets chart version from apps/system/external-secrets.yaml" }}{{ end }}

{{- /*
  [ARGOCD-OIDC] Login mode check. Argo CD later manages itself from apps/system/argo.yaml; if that file used the other
  mode, syncing the argocd app would silently switch the login back. Fail early instead.
*/}}
{{- $argoAuth := .Values.self.argoAuth }}
{{- if not (has $argoAuth (list "admin" "oidc")) }}{{ fail (printf "argo-bootstrap: argoAuth must be \"admin\" or \"oidc\", got %q" $argoAuth) }}{{ end }}
{{- $otherAuth := ternary "admin" "oidc" (eq $argoAuth "oidc") }}
{{- $appHasOverlay := false }}
{{- $appHasOtherOverlay := false }}
{{- $appHasEntraSecret := false }}
{{- range (readFile (printf "%s/apps/system/argo.yaml" .Environment.Name) | fromYaml).spec.sources }}
{{- if eq (get "chart" "" .) "argo-cd" }}
{{- range (get "helm.valueFiles" (list) .) }}
{{- if hasSuffix (printf "/argo-auth-%s.yaml" $argoAuth) . }}{{ $appHasOverlay = true }}{{ end }}
{{- if hasSuffix (printf "/argo-auth-%s.yaml" $otherAuth) . }}{{ $appHasOtherOverlay = true }}{{ end }}
{{- end }}
{{- end }}
{{- if eq (get "chart" "" .) "sscsid-keeper" }}{{ $appHasEntraSecret = true }}{{ end }}
{{- end }}
{{- if or (not $appHasOverlay) $appHasOtherOverlay }}{{ fail (printf "argo-bootstrap: argoAuth is %q, but apps/system/argo.yaml does not use only argo-auth-%s.yaml in the argo-cd valueFiles. Swap argo-auth-%s.yaml for argo-auth-%s.yaml there." $argoAuth $argoAuth $otherAuth $argoAuth) }}{{ end }}
{{- if ne $appHasEntraSecret (eq $argoAuth "oidc") }}{{ fail (printf "argo-bootstrap: argoAuth is %q, so the sscsid-keeper (argo-azure-entra-secret) source in apps/system/argo.yaml must be %s." $argoAuth (ternary "uncommented" "commented out" (eq $argoAuth "oidc"))) }}{{ end }}
repositories:
  - name: argo
    url: https://argoproj.github.io/argo-helm

releases:
{{- if eq $argoAuth "oidc" }}
  # [ARGOCD-OIDC] Only with argoAuth: oidc. Mounts the Entra app's client ID/secret from Key Vault for oidc.config.
  - name: argo-azure-entra-secret
    chart: oci://ghcr.io/unique-ag/helm-charts/sscsid-keeper
    version: 1.3.0
    namespace: {{ .Values.self.namespace }}
    wait: false
    values:
      - {{ .Environment.Name }}/values/argo/argo-azure-entra-secret.yaml
{{- end }}
  - name: argo
{{- if eq $argoAuth "oidc" }}
    needs:
      - argo-azure-entra-secret
{{- end }}
    createNamespace: true
    namespace: {{ .Values.self.namespace }}
    chart: argo/argo-cd
    version: 9.3.5
    # On a fresh cluster the diff runs before the presync hook has installed the ESO CRDs; skip the cluster
    # validation for that first install only. Later runs validate as usual.
    disableValidationOnInstall: true
    hooks:
      - events: ["presync"]
        showlogs: true
        command: kubectl
        args:
          - apply
          - --server-side
          - --force-conflicts
          - -f
          - https://raw.githubusercontent.com/external-secrets/external-secrets/v{{ $esoVersion }}/deploy/crds/bundle.yaml
    values:
      - {{ .Environment.Name }}/values/argo/argo.yaml
      - {{ .Environment.Name }}/values/argo/argo-auth-{{ $argoAuth }}.yaml
      - {{ .Environment.Name }}/values/argo/argo-repository-secrets.yaml

  - name: argo-appsets
    needs:
      - argo
    createNamespace: true
    namespace: {{ .Values.self.namespace }}
    chart: argo/argocd-apps
    version: 2.0.2
    # The ApplicationSet CRD comes with the argo release, which is not installed yet when the first diff runs.
    disableValidationOnInstall: true
    values:
      - {{ .Environment.Name }}/values/argo/argo-appsets.yaml
