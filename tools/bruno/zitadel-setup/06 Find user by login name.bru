meta {
  name: 06 Find user by login name
  type: http
  seq: 6
}

post {
  url: {{zitadelUrl}}/management/v1/users/_search
  body: json
  auth: inherit
}

body:json {
  {
    "queries": [
      { "loginNameQuery": { "loginName": "{{loginName}}", "method": "TEXT_QUERY_METHOD_EQUALS" } }
    ]
  }
}

script:post-response {
  const users = (res.body && res.body.result) || [];
  if (res.status === 200 && users.length === 1) {
    bru.setEnvVar("userId", users[0].id);
  }
}

tests {
  test("exactly one user found", function () {
    expect(res.status).to.equal(200);
    expect((res.body.result || []).length).to.equal(1);
  });
}

docs {
  Looks up the user who should get the roles and stores its ID in `userId`.

  Set `loginName` in the environment first: the full login name shown on the user's page in Zitadel,
  e.g. `anto@cluster-iam.sb-trilaksono.unique.dev`. Use a personal human user, not the root user or a
  service user.
}
