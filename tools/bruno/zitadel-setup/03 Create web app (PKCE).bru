meta {
  name: 03 Create web app (PKCE)
  type: http
  seq: 3
}

post {
  url: {{zitadelUrl}}/management/v1/projects/{{projectId}}/apps/oidc
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{appName}}",
    "redirectUris": [
      "https://{{baseUrl}}/chat",
      "https://{{baseUrl}}/knowledge-upload",
      "https://{{baseUrl}}/theme",
      "https://{{baseUrl}}/admin"
    ],
    "postLogoutRedirectUris": [
      "https://{{baseUrl}}/chat",
      "https://{{baseUrl}}/knowledge-upload",
      "https://{{baseUrl}}/theme",
      "https://{{baseUrl}}/admin"
    ],
    "responseTypes": ["OIDC_RESPONSE_TYPE_CODE"],
    "grantTypes": ["OIDC_GRANT_TYPE_AUTHORIZATION_CODE", "OIDC_GRANT_TYPE_REFRESH_TOKEN"],
    "appType": "OIDC_APP_TYPE_WEB",
    "authMethodType": "OIDC_AUTH_METHOD_TYPE_NONE",
    "version": "OIDC_VERSION_1_0",
    "devMode": false,
    "accessTokenType": "OIDC_TOKEN_TYPE_JWT",
    "accessTokenRoleAssertion": true,
    "idTokenRoleAssertion": true,
    "idTokenUserinfoAssertion": true
  }
}

script:post-response {
  if (res.status === 200 && res.body.clientId) {
    bru.setEnvVar("appId", res.body.appId);
    bru.setEnvVar("clientId", res.body.clientId);
  }
}

tests {
  test("app created with a client ID", function () {
    expect(res.status).to.equal(200);
    expect(res.body.clientId).to.be.a("string");
  });
}

docs {
  Creates the web application (guide sections 3.1 and 3.2) and stores `appId` and `clientId`.

  - Type WEB with PKCE: `authMethodType` NONE (no client secret).
  - Redirect and post-logout URIs: the four web apps under `https://{{baseUrl}}`.
  - Token settings: JWT access token, roles in the access token, roles and user info in the ID token.
  - Refresh tokens are allowed so the chat app can renew its session silently.

  `clientId` is the value for `ZITADEL_CLIENT_ID` in 03_applications/test/values/web-apps/_all.yaml.

  If the app already exists, run "08 List apps (find client ID)" instead.
}
